# Marketing-Bot (Custom ArtBOT) Environment Settings (.env)
# Copy to ~/.hermes/profiles/marketing-bot/.env (chmod 600).
# Do not commit live credentials or tenant webhook URLs to version control.
TEAMS_WEBHOOK_URL="https://<tenant-id>.<region>.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/<id>/workflows/<id>/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=<signature>"
API_SERVER_KEY="<hermes-gateway-api-server-key>"
HERMES_API_URL="http://127.0.0.1:8642/v1/responses"
TEAMS_TENANT_ID="<microsoft-entra-tenant-id>"
TEAMS_GROUP_ID="<microsoft-teams-group-id>"
TEAMS_CHANNEL_ID="19:<channel-thread-id>@thread.tacv2"
AGILITYPR_API_KEY="<agility-pr-media-intelligence-api-key>"
AGILITY_MCP_URL="https://apigateway.agilitypr.com/api/mcp"
AGILITY_REST_URL="https://mediaintelligence.agilitypr.com/api/v1"
MARKETING_BOT_HANDLE="marketing-bot"
GOOGLE_API_KEY="<google-ai-studio-api-key>"
